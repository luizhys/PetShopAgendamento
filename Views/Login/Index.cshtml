@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetCare – Login</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <style>

    </style>
</head>
<body>

<div class="card shadow-sm p-4 login-card">
    <div class="login-icon"><i class="fa-solid fa-paw fa-rotate-by" style="color: rgb(255, 255, 255); --fa-rotate-angle: 45deg;"></i></div>
    <h5 class="text-center fw-semibold mb-1">PetCare</h5>
    <p class="text-center text-muted mb-4" style="font-size:13px">Acesso para funcionários e administradores</p>

    <form method="post" asp-action="Index" asp-controller="Login">
        <div class="mb-3">
            <label class="form-label">Login</label>
            <input type="text" name="login" class="form-control" placeholder="Seu usuário" required autofocus>
        </div>
        <div class="mb-3">
            <label class="form-label">Senha</label>
            <input type="password" name="senha" class="form-control" placeholder="Sua senha" required>
        </div>
        <button type="submit" class="btn-entrar">Entrar</button>

        @if (ViewBag.Erro != null)
        {
            <div class="text-erro">@ViewBag.Erro</div>
        }
    </form>
</div>

</body>
</html>