@model IEnumerable<PetShopAgendamento.Models.Usuario>

@{
    ViewData["Title"] = "Index";
}

<h1 class="fw-semibold mb-2">Usuários</h1>
<p class="text-muted mb-4">Cadastre e gerencie os usuários do sistema.</p>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mb-4">
    <a asp-action="Create" class="btn btn-teal"><i class="fa-solid fa-plus"></i> Novo usuário</a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cargo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Login)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Perfil)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cargo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Login)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Perfil)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-teal-sm"><i class="fa-solid fa-pen-to-square"></i> Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn-teal-sm"><i class="fa-solid fa-file-lines"></i> Detalhes</a>
                @if (item.Perfil != Perfil.Admin)
                {
                    <button type="button" class="btn-teal-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#genericDeleteModal"
                            data-id="@item.Id"
                            data-nome="@item.Nome"
                            data-action-url="@Url.Action("Delete", "Usuarios")">
                        <i class="fa-solid fa-trash"></i> Excluir
                    </button>
                }
            </td>
        </tr>
}
    </tbody>
</table>

@await Html.PartialAsync("_DeleteModal")
