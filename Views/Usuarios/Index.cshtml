@model IEnumerable<PetShopAgendamento.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3 gap-2">
    <div>
        <h1 class="fw-semibold mb-1">Usuários</h1>
        <p class="text-muted">Gerencie os usuários do sistema (administradores e funcionários).</p>
    </div>
    <a asp-action="Create" class="btn btn-teal">
        <i class="fas fa-plus"></i> Adicionar Usuário
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Nome)</th>
                <th class="d-none d-md-table-cell">@Html.DisplayNameFor(model => model.Cargo)</th>
                <th class="d-none d-lg-table-cell">@Html.DisplayNameFor(model => model.Email)</th>
                <th>@Html.DisplayNameFor(model => model.Login)</th>
                <th>@Html.DisplayNameFor(model => model.Perfil)</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                    <td class="d-none d-md-table-cell">@Html.DisplayFor(modelItem => item.Cargo)</td>
                    <td class="d-none d-lg-table-cell">@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Login)</td>
                    <td>@(item.Perfil == Perfil.Admin ? "Administrador" : "Funcionário")</td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end flex-wrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-teal" title="Editar">
                                <i class="fas fa-pen"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-teal" title="Detalhes">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            @if (item.Perfil != Perfil.Admin)
                            {
                                <button type="button" class="btn btn-teal"
                                        data-bs-toggle="modal"
                                        data-bs-target="#genericDeleteModal"
                                        data-id="@item.Id"
                                        data-nome="@item.Nome"
                                        data-action-url="@Url.Action("Delete", "Usuarios")"
                                        title="Excluir">
                                    <i class="fas fa-trash"></i>
                                </button>
                            }
                            else
                            {
                                <span class="btn btn-teal disabled" title="Administradores não podem ser excluídos">
                                    <i class="fas fa-trash"></i>
                                </span>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_DeleteModal")