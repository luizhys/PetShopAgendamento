@using static PetShopAgendamento.Models.Pet
@model PetShopAgendamento.Models.Pet

@{
    ViewData["Title"] = "Editar Pet";
}

<div class="text-center mb-4">
    <h1 class="fw-semibold">Editar Pet</h1>
    <p class="text-muted">Atualize as informações do animal.</p>
</div>

<div class="d-flex justify-content-center">
    <div class="col-12 col-md-6">
        <form asp-action="Edit" class="card p-3 p-md-4 shadow-sm mb-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Nome" class="form-label fw-semibold"></label>
                <input asp-for="Nome" class="form-control" placeholder="Nome do pet" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Raca" class="form-label fw-semibold"></label>
                <input asp-for="Raca" class="form-control" placeholder="Ex: Vira-lata, Poodle, Labrador" />
                <span asp-validation-for="Raca" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Porte" class="form-label fw-semibold"></label>
                <select asp-for="Porte" class="form-select" asp-items="Html.GetEnumSelectList<PorteOpcao>()">
                    <option value="">Selecione...</option>
                </select>
                <span asp-validation-for="Porte" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Peso" class="form-label fw-semibold"></label>
                <input asp-for="Peso" class="form-control" placeholder="Peso em quilos" />
                <span asp-validation-for="Peso" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Observacoes" class="form-label fw-semibold"></label>
                <textarea asp-for="Observacoes" class="form-control" rows="3" placeholder="Informações adicionais (alergias, comportamento, etc.)"></textarea>
                <span asp-validation-for="Observacoes" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClienteId" class="form-label fw-semibold"></label>
                <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId">
                    <option value="">Selecione o responsável...</option>
                </select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end mt-3">
                <a asp-action="Index" class="btn btn-teal">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
                <button type="submit" class="btn btn-teal">
                    <i class="fas fa-save"></i> Salvar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}