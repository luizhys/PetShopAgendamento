@using static PetShopAgendamento.Models.Pet
@model PetShopAgendamento.Models.Pet

@{
    ViewData["Title"] = "Detalhes do Pet";
}

<div class="text-center mb-4">
    <h1 class="fw-semibold">Detalhes do Pet</h1>
    <p class="text-muted">Visualize as informações do animal.</p>
</div>

<div class="d-flex justify-content-center">
    <div class="col-12 col-md-6">
        <div class="card p-3 p-md-4 shadow-sm">
            <dl class="row mb-0">
                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Nome)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">@Model.Nome</dd>

                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Raca)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">@(string.IsNullOrEmpty(Model.Raca) ? "—" : Model.Raca)</dd>

                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Porte)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">@Model.Porte</dd>

                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Peso)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">@(Model.Peso == 0 ? "Não informado" : $"{Model.Peso} kg")</dd>

                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Observacoes)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">@(string.IsNullOrEmpty(Model.Observacoes) ? "—" : Model.Observacoes)</dd>

                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Cliente)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">@(Model.Cliente!.Nome)</dd>
            </dl>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end mt-3">
                <a asp-action="Index" class="btn btn-teal">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-teal">
                    <i class="fas fa-edit"></i> Editar
                </a>
            </div>
        </div>
    </div>
</div>