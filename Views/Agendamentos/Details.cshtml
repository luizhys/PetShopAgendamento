@model PetShopAgendamento.Models.Agendamento

@{
    ViewData["Title"] = "Detalhes do Agendamento";
}

<div class="text-center mb-4">
    <h1 class="fw-semibold">Detalhes do Agendamento</h1>
    <p class="text-muted">Visualize as informações do agendamento.</p>
</div>

<div class="d-flex justify-content-center">
    <div class="col-12 col-md-6">
        <div class="card p-3 p-md-4 shadow-sm mb-4">
            <dl class="row mb-0">
                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Cliente)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">
                    @Model.Cliente!.Nome
                </dd>

                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Pet)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">
                    @Model.Pet!.Nome
                </dd>

                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Servico)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">
                    @Model.Servico!.Nome
                </dd>

                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Data)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">
                    @Model.Data.ToString("dd/MM/yyyy HH:mm")
                </dd>

                @{
                    string badgeClass = "bg-secondary";
                    string statusTexto = "";

                    switch (Model.Status)
                    {
                        case StatusAgendamento.Agendado:
                            badgeClass = "bg-info text-dark";
                            statusTexto = "Agendado";
                            break;
                        case StatusAgendamento.EmAndamento:
                            badgeClass = "bg-warning text-dark";
                            statusTexto = "Em andamento";
                            break;
                        case StatusAgendamento.Concluido:
                            badgeClass = "bg-success";
                            statusTexto = "Concluído";
                            break;
                        case StatusAgendamento.Cancelado:
                            badgeClass = "bg-danger";
                            statusTexto = "Cancelado";
                            break;
                        default:
                            statusTexto = Model.Status.ToString();
                            break;
                    }
                }

                <dt class="col-sm-4 fw-semibold">@Html.DisplayNameFor(model => model.Status)</dt>
                <dd class="col-sm-8 mb-3 pb-2 border-bottom">
                    <span class="badge @badgeClass rounded-pill px-3">@statusTexto</span>
                </dd>
            </dl>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end mt-3">
                <a asp-action="Index" class="btn btn-teal">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-teal">
                    <i class="fas fa-edit"></i> Editar
                </a>
            </div>
        </div>
    </div>
</div>