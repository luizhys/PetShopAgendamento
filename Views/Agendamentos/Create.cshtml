@model PetShopAgendamento.Models.Agendamento

@{
    ViewData["Title"] = "Adicionar Agendamento";
}

<div class="text-center mb-4">
    <h1 class="fw-semibold">Adicionar Agendamento</h1>
    <p class="text-muted">Agende um serviço para um pet.</p>
</div>

<div class="d-flex justify-content-center">
    <div class="col-12 col-md-6">
        <form asp-action="Create" class="card p-3 p-md-4 shadow-sm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="ClienteId" class="form-label fw-semibold"></label>
                <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId">
                    <option value="">Selecione o cliente...</option>
                </select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PetId" class="form-label fw-semibold"></label>
                <select asp-for="PetId" class="form-select" asp-items="ViewBag.PetId">
                    <option value="">Selecione o pet...</option>
                </select>
                <span asp-validation-for="PetId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ServicoId" class="form-label fw-semibold"></label>
                <select asp-for="ServicoId" class="form-select" asp-items="ViewBag.ServicoId">
                    <option value="">Selecione o serviço...</option>
                </select>
                <span asp-validation-for="ServicoId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-12 col-sm-6 mb-3">
                    <label class="form-label fw-semibold">Data</label>
                    <input type="date" name="dataDate" class="form-control" required />
                </div>
                <div class="col-12 col-sm-6 mb-3">
                    <label class="form-label fw-semibold">Hora</label>
                    <input type="time" name="dataTime" class="form-control" required />
                </div>
            </div>
            <span asp-validation-for="Data" class="text-danger"></span>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end mt-3">
                <a asp-action="Index" class="btn btn-teal">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
                <button type="submit" class="btn btn-teal">
                    <i class="fa-regular fa-calendar-check"></i> Agendar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}