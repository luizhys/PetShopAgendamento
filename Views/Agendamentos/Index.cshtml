@using PetShopAgendamento.Models
@using PetShopAgendamento.Extensions
@model IEnumerable<PetShopAgendamento.Models.Agendamento>

@{
    ViewData["Title"] = "Index";
}

<h1 class="fw-semibold mb-2">Agendamentos</h1>
<p class="text-muted mb-4">Cadastre e gerencie os atendimentos.</p>

<div class="mb-4">
    <a asp-action="Create" class="btn btn-teal"><i class="fa-solid fa-plus"></i> Novo agendamento</a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Cliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pet)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Servico)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Data)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Cliente!.Endereco)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Pet!.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Servico!.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Data)
            </td>
            <td>
                <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="id" value="@item.Id" />
                    <select name="novoStatus" class="form-select form-select-sm w-auto">
                        @foreach (var status in Enum.GetValues(typeof(StatusAgendamento)))
                        {
                            var statusEnum = (StatusAgendamento)status;
                            <option value="@((int)statusEnum)" selected="@(statusEnum == item.Status)">
                                @statusEnum.GetDisplayName()
                            </option>
                        }
                    </select>
                        <button type="submit" class="btn btn-teal-sm btn-sm"><i class="fa-solid fa-arrows-rotate"></i> Atualizar</button>
                </form>
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-teal-sm"><i class="fa-solid fa-pen-to-square"></i> Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn-teal-sm"><i class="fa-solid fa-file-lines"></i> Detalhes</a>
                <button type="button" class="btn-teal-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#genericDeleteModal"
                        data-id="@item.Id"
                        data-nome="Agendamento de @item.Cliente?.Nome para @item.Pet?.Nome em @item.Data.ToString("dd/MM/yyyy")"
                        data-action-url="@Url.Action("Delete", "Agendamentos")">
                        <i class="fa-solid fa-trash"></i> Excluir
                </button>
            </td>
        </tr>
}
    </tbody>
</table>

@await Html.PartialAsync("_DeleteModal")
