@using PetShopAgendamento.Models
@using PetShopAgendamento.Extensions
@model IEnumerable<PetShopAgendamento.Models.Agendamento>

@{
    ViewData["Title"] = "Agendamentos";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3 gap-2">
    <div>
        <h1 class="fw-semibold mb-1">Agendamentos</h1>
        <p class="text-muted">Gerencie os agendamentos do petshop.</p>
    </div>
    <a asp-action="Create" class="btn btn-teal">
        <i class="fas fa-plus"></i> Adicionar Agendamento
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Cliente)</th>
                <th>@Html.DisplayNameFor(model => model.Pet)</th>
                <th class="d-none d-md-table-cell">@Html.DisplayNameFor(model => model.Servico)</th>
                <th>@Html.DisplayNameFor(model => model.Data)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Cliente!.Nome)</td>
                    <td>@(item.Pet!.Nome)</td>
                    <td class="d-none d-md-table-cell">@(item.Servico!.Nome)</td>
                    <td>@item.Data.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center gap-1">
                            <input type="hidden" name="id" value="@item.Id" />
                            <select name="novoStatus" class="form-select form-select-sm w-auto">
                                @foreach (var status in Enum.GetValues(typeof(StatusAgendamento)))
                                {
                                    var statusEnum = (StatusAgendamento)status;
                                    <option value="@((int)statusEnum)" selected="@(statusEnum == item.Status)">
                                        @statusEnum.GetDisplayName()
                                    </option>
                                }
                            </select>
                            <button type="submit" class="btn btn-teal btn-sm" title="Atualizar status">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </form>
                    </td>
                    <td class="text-end">
                        <div class="d-flex gap-2 justify-content-end flex-wrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-teal" title="Editar">
                                <i class="fas fa-pen"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-teal" title="Detalhes">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            <button type="button" class="btn btn-teal"
                                    data-bs-toggle="modal"
                                    data-bs-target="#genericDeleteModal"
                                    data-id="@item.Id"
                                    data-nome="agendamento de @(item.Cliente?.Nome ?? "cliente") para o pet @(item.Pet?.Nome ?? "desconhecido")"
                                    data-action-url="@Url.Action("Delete", "Agendamentos")"
                                    title="Excluir">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_DeleteModal")
