@model PetShopAgendamento.Models.Servico

@{
    ViewData["Title"] = "Detalhes do Serviço";
}

<div class="text-center mb-4">
    <h1 class="fw-semibold">Detalhes do Serviço</h1>
    <p class="text-muted">Visualize as informações do serviço.</p>
</div>

<div class="d-flex justify-content-center">
    <div class="col-12 col-md-6">
        <div class="card p-3 p-md-4 shadow-sm">
            <dl class="row mb-0">
                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Nome)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">@Model.Nome</dd>

                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Descricao)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">
                    @(string.IsNullOrEmpty(Model.Descricao) ? "—" : Model.Descricao)
                </dd>

                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Valor)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">
                    @Model.Valor.ToString("C")  @* Exibe como moeda *@
                </dd>

                <dt class="col-12 col-md-4 fw-semibold">@Html.DisplayNameFor(model => model.Duracao)</dt>
                <dd class="col-12 col-md-8 mb-3 pb-2 border-bottom">
                    @(Model.Duracao == 0 ? "Duração não informada" : $"{Model.Duracao} minutos")
                </dd>
            </dl>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end mt-3">
                <a asp-action="Index" class="btn btn-teal">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-teal">
                    <i class="fas fa-edit"></i> Editar
                </a>
            </div>
        </div>
    </div>
</div>