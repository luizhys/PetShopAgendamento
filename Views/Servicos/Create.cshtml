@model PetShopAgendamento.Models.Servico

@{
    ViewData["Title"] = "Adicionar Serviço";
}

<div class="text-center mb-4">
    <h1 class="fw-semibold">Adicionar Serviço</h1>
    <p class="text-muted">Cadastre um novo serviço no sistema.</p>
</div>

<div class="d-flex justify-content-center">
    <div class="col-12 col-md-6">
        <form asp-action="Create" class="card p-3 p-md-4 shadow-sm  mb-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Nome" class="form-label fw-semibold"></label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: Banho, Tosa, Consulta" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Descricao" class="form-label fw-semibold"></label>
                <textarea asp-for="Descricao" class="form-control" rows="3" placeholder="Detalhes do serviço"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Valor" class="form-label fw-semibold"></label>
                <input asp-for="Valor" class="form-control" placeholder="Ex: 50,00" />
                <span asp-validation-for="Valor" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Duracao" class="form-label fw-semibold"></label>
                <input asp-for="Duracao" class="form-control" placeholder="Duração em minutos" />
                <span asp-validation-for="Duracao" class="text-danger"></span>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end mt-3">
                <a asp-action="Index" class="btn btn-teal">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
                <button type="submit" class="btn btn-teal">
                    <i class="fas fa-plus"></i> Adicionar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}