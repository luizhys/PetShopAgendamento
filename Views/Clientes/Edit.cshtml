@model PetShopAgendamento.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="text-center mb-4">
    <h1 class="fw-semibold">Editar Cliente</h1>
    <p class="text-muted">Atualize as informações do cliente.</p>
</div>

<div class="d-flex justify-content-center">
    <div class="col-12 col-md-6">
        <form asp-action="Edit" class="card p-3 p-md-4 shadow-sm mb-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Nome" class="form-label fw-semibold"></label>
                <input asp-for="Nome" class="form-control" placeholder="Nome completo" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Telefone" class="form-label fw-semibold"></label>
                <input asp-for="Telefone" class="form-control" placeholder="(00) 00000-0000" />
                <span asp-validation-for="Telefone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" placeholder="cliente@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Endereco" class="form-label fw-semibold"></label>
                <input asp-for="Endereco" class="form-control" placeholder="Rua, número, cidade..." />
                <span asp-validation-for="Endereco" class="text-danger"></span>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end mt-3">
                <a asp-action="Index" class="btn btn-teal">
                    <i class="fas fa-arrow-left"></i> Voltar
                </a>
                <button type="submit" class="btn btn-teal">
                    <i class="fas fa-save"></i> Salvar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}