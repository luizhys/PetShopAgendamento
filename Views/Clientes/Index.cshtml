@model IEnumerable<PetShopAgendamento.Models.Cliente>
@using PetShopAgendamento.Utils

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3 gap-2">
    <div>
        <h1 class="fw-semibold mb-1">Clientes</h1>
        <p class="text-muted">Gerencie os clientes cadastrados.</p>
    </div>
    <a asp-action="Create" class="btn btn-teal">
        <i class="fas fa-plus"></i> Adicionar Cliente
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Nome)</th>
                <th>@Html.DisplayNameFor(model => model.Telefone)</th>
                <th class="d-none d-md-table-cell">@Html.DisplayNameFor(model => model.Email)</th>
                <th class="d-none d-lg-table-cell">@Html.DisplayNameFor(model => model.Endereco)</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                    <td>@FormatadorTelefone.Formatar(item.Telefone)</td>
                    <td class="d-none d-md-table-cell">@(string.IsNullOrEmpty(item.Email) ? "—" : item.Email)</td>
                    <td class="d-none d-lg-table-cell">@(string.IsNullOrEmpty(item.Endereco) ? "—" : item.Endereco)</td>
                    <td class="text-end">
                        <div class="d-flex gap-1 gap-sm-2 justify-content-end flex-wrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-teal-sm" title="Editar">
                                <i class="fas fa-pen"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-teal-sm" title="Detalhes">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            <button type="button" class="btn btn-teal-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#genericDeleteModal"
                                    data-id="@item.Id"
                                    data-nome="@item.Nome"
                                    data-action-url="@Url.Action("Delete", "Clientes")"
                                    title="Excluir">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_DeleteModal")